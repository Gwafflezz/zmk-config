#include <dt-bindings/zmk/matrix_transform.h>

/* Extension for SuperMini nRF52840 battery voltage divider */
&vbatt {
    /delete-property/ power-gpios;
    io-channels = <&adc 2>;
    output-ohms = <1000000>;
    full-ohms = <2000000>;
};

&led_strip {
    chain-length = <27>;
};
