#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>
/* behaviors.dtsi traz behaviors/mouse_keys.dtsi (&mmv, &msc, mmv_input_listener),
 * mas NAO traz os input processors -- zip_xy_scaler e' declarado em
 * input/processors.dtsi e precisa deste include separado. Sem ele o &zip_xy_scaler
 * la' embaixo referencia um label inexistente e o devicetree nao compila. */
#include <input/processors.dtsi>

&led_strip {
    chain-length = <27>;
};

/* Resposta instantanea sem ramp-up / sem dampening */
&mmv {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/* Turbo (camada 4): dobra o deslocamento do cursor enquanto a camada estiver
 * ativa.
 *
 * Precisa ser um input processor, nao bindings mais rapidos numa camada. O ZMK
 * resolve o binding de uma tecla uma unica vez, no press, e o &mmv fica preso
 * ao valor com que foi instanciado ate' o release -- entao trocar de camada com
 * uma tecla de movimento ja' segurada nao muda velocidade nenhuma. O processador
 * age no fluxo de eventos do listener, e por isso alcanca o cursor em pleno
 * movimento, que e' o caso de uso do Ç.
 *
 * Nao afeta o scroll: &msc tem listener proprio. */
&mmv_input_listener {
    turbo {
        layers = <4>;
        input-processors = <&zip_xy_scaler 2 1>;
    };
};

/ {
        chosen {
                zmk,battery = &vbatt;
        };

        vbatt: vbatt {
                compatible = "zmk,battery-voltage-divider";
                io-channels = <&adc 2>;
                output-ohms = <1000000>;
                full-ohms = <2000000>;
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        macros {
                // Emite F13 ao entrar na lower (layer 1) e F14 ao sair.
                // O overlay escuta esses sinais via evdev para funcionar por BT.
                lower_mo: lower_mo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&macro_press &mo 1>
                                 , <&macro_tap &kp F13>
                                 , <&macro_pause_for_release>
                                 , <&macro_release &mo 1>
                                 , <&macro_tap &kp F14>
                                 ;
                };
                raise_mo: raise_mo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&macro_press &mo 2>
                                 , <&macro_tap &kp F15>
                                 , <&macro_pause_for_release>
                                 , <&macro_release &mo 2>
                                 , <&macro_tap &kp F16>
                                 ;
                };

                // Turbo momentaneo do Ç, montado com &tog em vez de &mo.
                // Na bancada o &tog 4 sobe a camada 4 com o cursor em
                // movimento, e o &mo 4 nao sobe. Entao o momentaneo e'
                // construido a partir da primitiva que funciona: liga no
                // press, espera o release, desliga. Mesma forma dos macros
                // de polegar acima, que ja' se provaram neste teclado.
                // Validado em bancada no H (firmware ccac273) antes de ser
                // movido para o Ç.
                turbo_mo: turbo_mo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&macro_tap &tog 4>
                                 , <&macro_pause_for_release>
                                 , <&macro_tap &tog 4>
                                 ;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  Ç  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | ENT |   | SPC | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp RA(C) &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &lower_mo &kp RET     &kp SPACE &raise_mo &kp RALT
                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   | VDN | VUP |  UP | SUN+| SUN-| DEL  |
// | SHFT |  6  |  7  |  8  |  9  |  0  |   | PLAY| LFT | DWN | RGT | PRSC|      |
// | CTRL |     |     |     |     |     |   | HOME| PGUP| PGDN| END |     |      |
//                    | GUI |     | ENT |   | SPC |     | ALT |
                        bindings = <
   &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp C_VOL_DN  &kp C_VOL_UP  &kp UP    &kp C_BRI_UP  &kp C_BRI_DN  &kp DEL
   &kp LSHFT  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &kp C_PP      &kp LEFT      &kp DOWN  &kp RIGHT     &kp PRINTSCREEN &trans
   &kp LCTRL  &trans  &trans  &trans  &trans  &trans    &kp HOME      &kp PG_UP     &kp PG_DN &kp END       &trans        &trans
                              &kp LGUI &trans &kp RET   &kp SPACE     &trans        &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | SHFT |     |     |     |     |     |   |  -  |  =  |  {  |  }  |  \  |  `   |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  {  |  }  |  \  |  `   |
//                    | GUI |     | ENT |   | SPC |     | ALT |
                        bindings = <
   &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &kp BSPC
   &kp LSHFT  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &kp BSLH  &kp GRAVE
   &kp LCTRL  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &kp BSLH  &kp GRAVE
                              &kp LGUI &trans &kp RET   &kp SPACE  &trans     &kp RALT
                        >;
                };

                mouse_layer {
// -----------------------------------------------------------------------------------------
// | UNLOK| NONE| NONE| NONE| NONE| NONE|   | SCRL| SCRL|  UP | SCRL| SCRL| NONE |
// | SHFT | NONE| MID | RGHT| LEFT| NONE|   | STIK| LFT | DWN | RGT | TURB| PREV |
// | CTRL | NONE| NONE| NONE| NONE| NONE|   | NONE| NONE| NONE| RGB | BRD | BRI  |
//                    | NONE| BASE| NONE|   | NONE| NONE| NONE|
//
// TURB (Ç) = &turbo_mo: segura acelera 2x, solta volta ao normal.
// STIK (H) = &tog 5: trava o modo mouse na camada 5 (clone desta), que
// sobrevive ao soltar dos polegares. Sem isso, soltar LWR+RSE derruba a
// camada 3 mesmo com o cursor ainda deslizando (a instancia do &mmv da tecla
// segurada sobrevive), e o proximo press resolve na camada 0 -- foi assim que
// o Ç "nao funcionava": imprimia © porque o press caia no RA(C) da base.
                        bindings = <
   &studio_unlock &none &none    &none    &none    &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &mmv MOVE_Y(-600) &msc SCRL_UP    &msc SCRL_RIGHT &none
   &kp LSHFT      &none &mkp MCLK &mkp RCLK &mkp LCLK &none    &tog 5          &mmv MOVE_X(-600) &mmv MOVE_Y(600) &mmv MOVE_X(600) &turbo_mo       &kp C_PREV
   &kp LCTRL      &none &none    &none    &none    &none    &none           &none           &none            &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI
                                 &none    &to 0    &none    &none           &none           &none
                        >;
                };

                turbo_layer {
// -----------------------------------------------------------------------------------------
// Bindings identicos aos da camada 3 -- de proposito. A velocidade nao vem
// daqui, vem do &zip_xy_scaler que o &mmv_input_listener aplica enquanto esta
// camada estiver ativa. Duplicar as teclas em vez de usar &trans mantem a
// camada auto-suficiente: se ela ficar ativa sozinha (residuo de toggle
// dessincronizado), nao ha' fallthrough para a camada 0 vazando letras -- e o
// polegar BASE (&to 0) continua sendo a saida garantida.
// | UNLOK| NONE| NONE| NONE| NONE| NONE|   | SCRL| SCRL|  UP | SCRL| SCRL| NONE |
// | SHFT | NONE| MID | RGHT| LEFT| NONE|   | STIK| LFT | DWN | RGT | TURB| PREV |
// | CTRL | NONE| NONE| NONE| NONE| NONE|   | NONE| NONE| NONE| RGB | BRD | BRI  |
//                    | NONE| BASE| NONE|   | NONE| NONE| NONE|
//
// O Ç aqui tambem e' &turbo_mo (espelhando a camada 3): qualquer press com a
// camada 4 ja' ativa mantem os taps de &tog pareados por instancia em vez de
// dessincronizar. Mesmo desenho que funcionou no H em ccac273.
                        bindings = <
   &studio_unlock &none &none    &none    &none    &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &mmv MOVE_Y(-600) &msc SCRL_UP    &msc SCRL_RIGHT &none
   &kp LSHFT      &none &mkp MCLK &mkp RCLK &mkp LCLK &none    &tog 5          &mmv MOVE_X(-600) &mmv MOVE_Y(600) &mmv MOVE_X(600) &turbo_mo       &kp C_PREV
   &kp LCTRL      &none &none    &none    &none    &none    &none           &none           &none            &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI
                                 &none    &to 0    &none    &none           &none           &none
                        >;
                };

                sticky_mouse_layer {
// -----------------------------------------------------------------------------------------
// Clone da camada 3 que NAO depende do conditional_layers: e' ativada por
// &tog 5 (tap no H da camada 3) e por isso sobrevive ao soltar dos polegares.
// E' aqui que o gesto real de mouse acontece: entra pelos polegares, trava com
// H, solta os polegares e navega. O Ç (&turbo_mo) resolve nesta camada e o
// turbo funciona sem depender de LWR+RSE seguros.
//
// Saidas auditadas (regra anti-lockout): H (&tog 5, a propria) e o polegar
// BASE (&to 0). Duas rotas independentes que baixam o estado de camada.
// | UNLOK| NONE| NONE| NONE| NONE| NONE|   | SCRL| SCRL|  UP | SCRL| SCRL| NONE |
// | SHFT | NONE| MID | RGHT| LEFT| NONE|   | STIK| LFT | DWN | RGT | TURB| PREV |
// | CTRL | NONE| NONE| NONE| NONE| NONE|   | NONE| NONE| NONE| RGB | BRD | BRI  |
//                    | NONE| BASE| NONE|   | NONE| NONE| NONE|
                        bindings = <
   &studio_unlock &none &none    &none    &none    &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &mmv MOVE_Y(-600) &msc SCRL_UP    &msc SCRL_RIGHT &none
   &kp LSHFT      &none &mkp MCLK &mkp RCLK &mkp LCLK &none    &tog 5          &mmv MOVE_X(-600) &mmv MOVE_Y(600) &mmv MOVE_X(600) &turbo_mo       &kp C_PREV
   &kp LCTRL      &none &none    &none    &none    &none    &none           &none           &none            &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI
                                 &none    &to 0    &none    &none           &none           &none
                        >;
                };
        };
};
