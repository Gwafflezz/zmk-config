#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

&led_strip {
    chain-length = <27>;
};

/* Resposta instantanea sem ramp-up / sem dampening */
&mmv {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
        chosen {
                zmk,battery = &vbatt;
        };

        vbatt: vbatt {
                compatible = "zmk,battery-voltage-divider";
                io-channels = <&adc 2>;
                output-ohms = <1000000>;
                full-ohms = <2000000>;
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        macros {
                // Emite F13 ao entrar na lower (layer 1) e F14 ao sair.
                // O overlay escuta esses sinais via evdev para funcionar por BT.
                lower_mo: lower_mo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&macro_press &mo 1>
                                 , <&macro_tap &kp F13>
                                 , <&macro_pause_for_release>
                                 , <&macro_release &mo 1>
                                 , <&macro_tap &kp F14>
                                 ;
                };
                raise_mo: raise_mo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&macro_press &mo 2>
                                 , <&macro_tap &kp F15>
                                 , <&macro_pause_for_release>
                                 , <&macro_release &mo 2>
                                 , <&macro_tap &kp F16>
                                 ;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  Ç  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | ENT |   | SPC | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp RA(C) &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &lower_mo &kp RET     &kp SPACE &raise_mo &kp RALT
                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   | VDN | VUP |  UP | SUN+| SUN-| DEL  |
// | SHFT |  6  |  7  |  8  |  9  |  0  |   | PLAY| LFT | DWN | RGT | PRSC|      |
// | CTRL |     |     |     |     |     |   | HOME| PGUP| PGDN| END |     |      |
//                    | GUI |     | ENT |   | SPC |     | ALT |
                        bindings = <
   &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp C_VOL_DN  &kp C_VOL_UP  &kp UP    &kp C_BRI_UP  &kp C_BRI_DN  &kp DEL
   &kp LSHFT  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &kp C_PP      &kp LEFT      &kp DOWN  &kp RIGHT     &kp PRINTSCREEN &trans
   &kp LCTRL  &trans  &trans  &trans  &trans  &trans    &kp HOME      &kp PG_UP     &kp PG_DN &kp END       &trans        &trans
                              &kp LGUI &trans &kp RET   &kp SPACE     &trans        &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | SHFT |     |     |     |     |     |   |  -  |  =  |  {  |  }  |  \  |  `   |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  {  |  }  |  \  |  `   |
//                    | GUI |     | ENT |   | SPC |     | ALT |
                        bindings = <
   &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &kp BSPC
   &kp LSHFT  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &kp BSLH  &kp GRAVE
   &kp LCTRL  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &kp BSLH  &kp GRAVE
                              &kp LGUI &trans &kp RET   &kp SPACE  &trans     &kp RALT
                        >;
                };

                mouse_layer {
// -----------------------------------------------------------------------------------------
// | UNLOK| NONE| NONE| NONE| NONE| NONE|   | SCRL| SCRL|  UP | SCRL| SCRL| NONE |
// | SHFT | NONE| MID | RGHT| LEFT| NONE|   | DPI | LFT | DWN | RGT | TURB| PREV |
// | CTRL | NONE| NONE| NONE| NONE| NONE|   | NONE| NONE| NONE| RGB | BRD | BRI  |
//                    | NONE| NONE| NONE|   | NONE| NONE| NONE|
                        bindings = <
   &studio_unlock &none &none    &none    &none    &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &mmv MOVE_Y(-600) &msc SCRL_UP    &msc SCRL_RIGHT &none
   &kp LSHFT      &none &mkp MCLK &mkp RCLK &mkp LCLK &none    &to 4           &mmv MOVE_X(-600) &mmv MOVE_Y(600) &mmv MOVE_X(600) &mo 4           &kp C_PREV
   &kp LCTRL      &none &none    &none    &none    &none    &none           &none           &none            &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI
                                 &none    &none    &none    &none           &none           &none
                        >;
                };

                fast_mouse_layer {
// -----------------------------------------------------------------------------------------
// | UNLOK| NONE| NONE| NONE| NONE| NONE|   | SCRL| SCRL| UP2X| SCRL| SCRL| NONE |
// | SHFT | NONE| MID | RGHT| LEFT| NONE|   | DPI |LFT2X|DWN2X|RGT2X| TURB| PREV |
// | CTRL | NONE| NONE| NONE| NONE| NONE|   | NONE| NONE| NONE| RGB | BRD | BRI  |
//                    | NONE| NONE| NONE|   | NONE| NONE| NONE|
                        bindings = <
   &studio_unlock &none &none    &none    &none    &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &mmv MOVE_Y(-1800) &msc SCRL_UP    &msc SCRL_RIGHT &none
   &kp LSHFT      &none &mkp MCLK &mkp RCLK &mkp LCLK &none    &to 5           &mmv MOVE_X(-1800) &mmv MOVE_Y(1800) &mmv MOVE_X(1800) &mo 5          &kp C_PREV
   &kp LCTRL      &none &none    &none    &none    &none    &none           &none           &none             &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI
                                 &none    &none    &none    &none           &none           &none
                        >;
                };

                ultra_mouse_layer {
// -----------------------------------------------------------------------------------------
// | UNLOK| NONE| NONE| NONE| NONE| NONE|   | SCRL| SCRL| UP3X| SCRL| SCRL| NONE |
// | SHFT | NONE| MID | RGHT| LEFT| NONE|   | DPI |LFT3X|DWN3X|RGT3X| TURB| PREV |
// | CTRL | NONE| NONE| NONE| NONE| NONE|   | NONE| NONE| NONE| RGB | BRD | BRI  |
//                    | NONE| NONE| NONE|   | NONE| NONE| NONE|
                        bindings = <
   &studio_unlock &none &none    &none    &none    &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &mmv MOVE_Y(-3000) &msc SCRL_UP    &msc SCRL_RIGHT &none
   &kp LSHFT      &none &mkp MCLK &mkp RCLK &mkp LCLK &none    &to 3           &mmv MOVE_X(-3000) &mmv MOVE_Y(3000) &mmv MOVE_X(3000) &none          &kp C_PREV
   &kp LCTRL      &none &none    &none    &none    &none    &none           &none           &none             &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI
                                 &none    &none    &none    &none           &none           &none
                        >;
                };
        };
};
