#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>
/* behaviors.dtsi traz behaviors/mouse_keys.dtsi (&mmv, &msc, mmv_input_listener),
 * mas NAO traz os input processors -- zip_xy_scaler e' declarado em
 * input/processors.dtsi e precisa deste include separado. Sem ele o &zip_xy_scaler
 * la' embaixo referencia um label inexistente e o devicetree nao compila. */
#include <input/processors.dtsi>

&led_strip {
    chain-length = <27>;
};

/* Resposta instantanea sem ramp-up / sem dampening */
&mmv {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/* Turbo (camada 4): dobra o deslocamento do cursor enquanto a camada estiver
 * ativa.
 *
 * Precisa ser um input processor, nao bindings mais rapidos numa camada. O ZMK
 * resolve o binding de uma tecla uma unica vez, no press, e o &mmv fica preso
 * ao valor com que foi instanciado ate' o release -- entao trocar de camada com
 * uma tecla de movimento ja' segurada nao muda velocidade nenhuma. O processador
 * age no fluxo de eventos do listener, e por isso alcanca o cursor em pleno
 * movimento, que e' o caso de uso do Ç.
 *
 * Nao afeta o scroll: &msc tem listener proprio. */
&mmv_input_listener {
    turbo {
        layers = <4>;
        input-processors = <&zip_xy_scaler 2 1>;
    };
};

/ {
        chosen {
                zmk,battery = &vbatt;
        };

        vbatt: vbatt {
                compatible = "zmk,battery-voltage-divider";
                io-channels = <&adc 2>;
                output-ohms = <1000000>;
                full-ohms = <2000000>;
        };

        /* conditional_layers removido para permitir que o combo dos 2 polegares
         * trava a camada de navegação (L3) sem que o desacionamento de L1/L2
         * desative L3 automaticamente ao soltar os polegares. */

        combos {
                compatible = "zmk,combos";
                // Pressionar ambos os polegares (37 + 40) na camada base (L0) trava L3
                combo_nav_layer {
                        timeout-ms = <50>;
                        key-positions = <37 40>;
                        bindings = <&tog 3>;
                        layers = <0>;
                };
        };

        macros {
                // Emite F13 ao entrar na lower (layer 1) e F14 ao sair.
                // O overlay escuta esses sinais via evdev para funcionar por BT.
                lower_mo: lower_mo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&macro_press &mo 1>
                                 , <&macro_tap &kp F13>
                                 , <&macro_pause_for_release>
                                 , <&macro_release &mo 1>
                                 , <&macro_tap &kp F14>
                                 ;
                };
                raise_mo: raise_mo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&macro_press &mo 2>
                                 , <&macro_tap &kp F15>
                                 , <&macro_pause_for_release>
                                 , <&macro_release &mo 2>
                                 , <&macro_tap &kp F16>
                                 ;
                };

                // Turbo momentaneo da tecla A (camadas de mouse), montado
                // com &tog em vez de &mo.
                turbo_mo: turbo_mo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&macro_tap &tog 4>
                                 , <&macro_pause_for_release>
                                 , <&macro_tap &tog 4>
                                 ;
                };
        };

        behaviors {
                // Tap-dance nas setas Cima e Baixo: 1 toque = movimento, 2 toques = scroll
                td_scrl_up: td_scrl_up {
                        compatible = "zmk,behavior-tap-dance";
                        #binding-cells = <0>;
                        tapping-term-ms = <180>;
                        bindings = <&mmv MOVE_Y(-600)>, <&msc SCRL_UP>;
                };
                td_scrl_down: td_scrl_down {
                        compatible = "zmk,behavior-tap-dance";
                        #binding-cells = <0>;
                        tapping-term-ms = <180>;
                        bindings = <&mmv MOVE_Y(600)>, <&msc SCRL_DOWN>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  Ç  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | ENT |   | SPC | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp RA(C) &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &lower_mo &kp RET     &kp SPACE &raise_mo &kp RALT
                        >;
                };

                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   | VDN | VUP |  UP | SUN+| SUN-| DEL  |
// | SHFT |  6  |  7  |  8  |  9  |  0  |   | PLAY| LFT | DWN | RGT | PRSC|      |
// | CTRL |     |     |     |     |     |   | HOME| PGUP| PGDN| END |     |      |
//                    | GUI |     | ENT |   | SPC |     | ALT |
                        bindings = <
   &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp C_VOL_DN  &kp C_VOL_UP  &kp UP    &kp C_BRI_UP  &kp C_BRI_DN  &kp DEL
   &kp LSHFT  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &kp C_PP      &kp LEFT      &kp DOWN  &kp RIGHT     &kp PRINTSCREEN &trans
   &kp LCTRL  &trans  &trans  &trans  &trans  &trans    &kp HOME      &kp PG_UP     &kp PG_DN &kp END       &trans        &trans
                              &kp LGUI &trans &kp RET   &kp SPACE     &trans        &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | SHFT |     |     |     |     |     |   |  -  |  =  |  {  |  }  |  \  |  `   |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  {  |  }  |  \  |  `   |
//                    | GUI |     | ENT |   | SPC |     | ALT |
                        bindings = <
   &kp TAB    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &kp BSPC
   &kp LSHFT  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &kp BSLH  &kp GRAVE
   &kp LCTRL  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &kp BSLH  &kp GRAVE
                              &kp LGUI &trans &kp RET   &kp SPACE  &trans     &kp RALT
                        >;
                };

                mouse_layer {
                // -----------------------------------------------------------------------------------------
                // | UNLOK| NONE| NONE| NONE| NONE| NONE|   | SCRL| SCRL| TD_UP| SCRL| SCRL| NONE |
                // | SHFT | TURB| MID | RGHT| LEFT| NONE|   | NONE| LFT | TD_DN| RGT | NONE| PREV |
                // | CTRL | NONE| NONE| NONE| NONE| NONE|   | NONE| NONE| NONE | RGB | NONE| BRI  |
                //                    | NONE| BASE| NONE|   | NONE| BASE| NONE |
                //
                // Ativação: combo nos 2 polegares (LWR + RSE) trava a camada L3 (toggle ON).
                // Desativação: pressionar qualquer um dos polegares (BASE) retorna para L0.
                // Tecla A = turbo (2x velocidade).
                // Setas Cima e Baixo: 1 toque = movimento Y, 2 toques = scroll Cima/Baixo.
                                bindings = <
                &studio_unlock &none     &none    &none    &none    &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &td_scrl_up       &msc SCRL_UP    &msc SCRL_RIGHT &none
                &kp LSHFT      &turbo_mo &mkp MCLK &mkp RCLK &mkp LCLK &none    &none           &mmv MOVE_X(-600) &td_scrl_down     &mmv MOVE_X(600) &none           &kp C_PREV
                &kp LCTRL      &none     &none    &none    &none    &none    &none           &none           &none             &rgb_ug RGB_TOG &none           &rgb_ug RGB_BRI
                                             &none    &to 0    &none    &none           &to 0           &none
                                >;
                };

                turbo_layer {
                // -----------------------------------------------------------------------------------------
                // Bindings identicos aos da camada 3.
                // | UNLOK| NONE| NONE| NONE| NONE| NONE|   | SCRL| SCRL| TD_UP| SCRL| SCRL| NONE |
                // | SHFT | TURB| MID | RGHT| LEFT| NONE|   | NONE| LFT | TD_DN| RGT | NONE| PREV |
                // | CTRL | NONE| NONE| NONE| NONE| NONE|   | NONE| NONE| NONE | RGB | NONE| BRI  |
                //                    | NONE| BASE| NONE|   | NONE| BASE| NONE |
                                bindings = <
                &studio_unlock &none     &none    &none    &none    &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &td_scrl_up       &msc SCRL_UP    &msc SCRL_RIGHT &none
                &kp LSHFT      &turbo_mo &mkp MCLK &mkp RCLK &mkp LCLK &none    &none           &mmv MOVE_X(-600) &td_scrl_down     &mmv MOVE_X(600) &none           &kp C_PREV
                &kp LCTRL      &none     &none    &none    &none    &none    &none           &none           &none             &rgb_ug RGB_TOG &none           &rgb_ug RGB_BRI
                                             &none    &to 0    &none    &none           &to 0           &none
                                >;
                };
        };
};
